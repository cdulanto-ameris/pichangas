# Copia este archivo a .env y completa con las credenciales de tu proyecto Supabase.
# Las VITE_* son públicas (llegan al navegador). SUPABASE_SERVICE_ROLE_KEY es SECRETA:
# solo servidor, nunca con prefijo VITE_, nunca commitear.

SUPABASE_PROJECT_ID=""
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Clave de la API de Anthropic para el armador con IA (Claude Sonnet 5).
# SECRETA: solo servidor, nunca con prefijo VITE_, nunca commitear el valor.
# Si falta, el armador cae al algoritmo determinista y la app funciona igual.
ANTHROPIC_API_KEY=""

# Secreto compartido entre la server function que dispara el armado con IA y la
# background function que lo ejecuta. Ese endpoint es público y gasta créditos:
# sin este secreto responde 401 y no arma nada.
# Cualquier string largo y aleatorio sirve. SECRETA: solo servidor, sin VITE_.
ARMADO_DT_SECRET=""
